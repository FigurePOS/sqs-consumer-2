{
    "compilerOptions": {
        "lib": ["ES2023"],
        "strict": false,
        "target": "ES2022",
        "module": "commonjs",
        "sourceMap": true,
        "declaration": true,
        "rootDir": "./src",
        "outDir": "./lib",
        "types": ["node", "mocha"],
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "**/*.spec.ts"]
}
